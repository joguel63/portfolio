---
import ButtonLink from '../atoms/ButtonLink.astro';
import Heading from '../atoms/Heading.astro';
import Text from '../atoms/Text.astro';

interface Props {
  title: string;
  heading: string;
  description: string;
  primaryAction: {
    label: string;
    href: string;
  };
  secondaryAction?: {
    label: string;
    href: string;
  };
}

const { title, heading, description, primaryAction, secondaryAction } = Astro.props as Props;
---

<section id="contacto" class="section section--contact" data-contact-root>
  <div class="contact contact--stitch">
    <div class="contact-card contact-card--closing" data-contact-card>
      <div class="panel contact-card__surface">
        <div class="contact-copy">
          <div class="section-header section-header--compact contact-header">
            <span data-contact-eyebrow>
              <Heading as="h2" size="sm">{title}</Heading>
            </span>
            <span data-contact-heading>
              <Heading as="h3" size="xl" className="contact__heading">{heading}</Heading>
            </span>
          </div>

          <span data-contact-description>
            <Text size="lead" className="contact__description">{description}</Text>
          </span>
        </div>

        <div class="contact-actions" data-contact-actions>
          <ButtonLink href={primaryAction.href} className="contact-actions__primary">{primaryAction.label}</ButtonLink>
          {secondaryAction && (
            <ButtonLink
              href={secondaryAction.href}
              variant="secondary"
              className="contact-actions__secondary"
              target="_blank"
              rel="noreferrer"
            >
              {secondaryAction.label}
            </ButtonLink>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initContactIntro } from '../../lib/animations/contact/init-contact-intro.ts';

  const root = document.querySelector('[data-contact-root]');

  if (root instanceof HTMLElement) {
    initContactIntro(root);
  }
</script>
