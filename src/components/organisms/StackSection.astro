---
import type { StackItemContent } from '../../lib/content/types/content';

import Heading from '../atoms/Heading.astro';
import SkillChip from '../molecules/SkillChip.astro';

interface Props {
  title: string;
  intro: string;
  items: StackItemContent[];
}

const { title, intro, items } = Astro.props as Props;
---

<section id="stack" class="section section--stack" data-stack-root>
  <div class="container">
    <div class="section-header section-header--stack" data-stack-header>
      <span class="eyebrow stack__eyebrow" data-stack-eyebrow>{title}</span>
      <div data-stack-title>
        <Heading as="h2" size="xl">{intro}</Heading>
      </div>
    </div>

    <div class="stack__cards">
      <div class="stack__grid" data-stack-grid>
        {items.map((item) => (
          <div class="stack__item" data-stack-card>
            <SkillChip
              label={item.label}
              category={item.category}
              description={item.description}
              skills={item.skills}
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { initStackIntro } from '../../lib/animations/stack/init-stack-intro.ts';

  const root = document.querySelector('[data-stack-root]');

  if (root instanceof HTMLElement) {
    initStackIntro(root);
  }
</script>
